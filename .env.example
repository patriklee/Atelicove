# Spring Boot database connection
DB_URL=jdbc:mysql://localhost:3307/atelicoveDB?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=atelicove_user
DB_PASSWORD=atelicove_pass

# Comma-separated React origins trusted to send the session cookie
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Local MySQL container settings
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=atelicoveDB
MYSQL_PORT=3307
